    const cityTotal=CityPotential.mw(CityPotential.totals().neutral);
    const districtPotential=DistrictAlloc.districts.reduce((s,d)=>s+d.potential,0);
    const cityDispatch=CityPotential.mw(CityPotential.totals().dispatch20);
    const districtTarget=parseFloat(DistrictAlloc.params['全域削峰总目标'].value)||0;
    const parent=DistrictAlloc.districts.find(d=>d.name===Aggregate.selectedDistrict);
    const parentTarget=parent?.final_target||0;
    const aggregateTarget=Aggregate.synergySummary.target/1000;
    const conservation=Math.abs(Aggregate.synergySummary.final+Aggregate.synergySummary.gap-Aggregate.synergySummary.target)<0.1;
    const safe=Aggregate.synergyBuildings.every(b=>b.final_target<=b.safety_limit+0.01&&b.potential<=b.baseLoad+0.01);
    const runs=Object.entries(Aggregate.executionResults);
    const runValid=runs.every(([id,r])=>{const b=Aggregate.synergyBuildings.find(x=>x.id===Number(id));return b&&Number.isFinite(r.actualReduction)&&r.actualReduction<=b.final_target+0.51&&Math.abs(r.gap-Math.max(0,b.final_target-r.actualReduction))<0.51;});
    return[
      {name:'样本数据口径',status:sample.pass&&sampleLimits?'pass':'fail',detail:sample.pass&&sampleLimits?'61户数量、基准负荷与潜力合计一致':'样本汇总或“潜力≤基准负荷”检查异常'},
      {name:'全市 → 区县',status:Math.abs(cityTotal-districtPotential)<0.1&&Math.abs(cityDispatch-districtTarget)<0.11&&city.pass?'pass':'fail',detail:`中性潜力 ${fmt(cityTotal,1)} MW；下发目标 ${fmt(districtTarget,1)} MW`},
      {name:'区县 → 楼宇',status:parent&&Math.abs(aggregateTarget-parentTarget)<0.001&&conservation?'pass':'fail',detail:parent?`${Aggregate.selectedDistrict}任务 ${fmt(parentTarget,2)} MW = 楼宇执行 ${fmt(Aggregate.synergySummary.final/1000,2)} MW + 缺口 ${fmt(Aggregate.synergySummary.gap/1000,2)} MW`:'未匹配到区县任务'},
      {name:'楼宇能力边界',status:safe?'pass':'fail',detail:safe?`${Aggregate.synergyBuildings.length}栋最终任务均未超过稳定能力安全上限`:'存在楼宇任务超过稳定能力或基准负荷'},
      {name:'单体仿真回写',status:!runs.length?'pending':runValid?'pass':'fail',detail:!runs.length?'尚未执行单体仿真':runValid?`已校验 ${runs.length}/${Aggregate.synergyBuildings.length} 栋，削减量与缺口关系正确`:'单体仿真结果与分配任务不一致'}
    ];
  },
  render(){
    const rows=this.results();
    const abnormal=rows.filter(r=>r.status==='fail').length;
    const icon={pass:'✓',pending:'…',fail:'!'},badge={pass:'badge-green',pending:'badge-yellow',fail:'badge-red'},label={pass:'通过',pending:'待校验',fail:'异常'};
    return `<details class="calc-logic" open><summary>✅ 全链路一致性校验 <span class="calc-hint">${abnormal?abnormal+' 项异常':'当前口径正常'} · 参数变化后自动更新</span></summary><div class="calc-body"><div class="data-table-wrapper"><table class="data-table"><thead><tr><th>校验环节</th><th>状态</th><th>校验结果</th></tr></thead><tbody>${rows.map(r=>`<tr><td style="text-align:left;font-weight:600">${r.name}</td><td><span class="badge ${badge[r.status]}">${icon[r.status]} ${label[r.status]}</span></td><td style="text-align:left">${r.detail}</td></tr>`).join('')}</tbody></table></div></div></details>`;
  }
};

