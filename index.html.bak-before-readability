          <polyline fill="none" stroke="#22d3ee" stroke-width="4" points="${chartPoints}"/>
          ${(e.timeline||[]).map((p,i)=>{const x=30+i*(640/Math.max(1,e.timeline.length-1));const y=170-(p.load-minLoad)/span*130;return `<circle cx="${x}" cy="${y}" r="4" fill="#60a5fa"><title>${p.stage}：${p.load}kW</title></circle><text x="${x}" y="195" fill="#94a3b8" font-size="9" text-anchor="middle">${p.minute}m</text>`}).join('')}
