/* ============================================================
   模块五：单体策略执行（执行闭环）
============================================================ */
const SingleCtrl={
  execution:null,
  selectedBuildingId:null,
  assignments(){if(!Aggregate.synergyBuildings.length)Aggregate.computeSynergy();return Aggregate.synergyBuildings.filter(b=>b.final_target>0.005);},
  loadAssignment(id){Aggregate.openDetail(id);},
  render(targetId='agTabBody',embedded=true){
    const el=document.getElementById(targetId);
    const assignments=this.assignments();
    const selected=assignments.find(b=>b.id===this.selectedBuildingId);
    if(!selected){el.innerHTML=`<div class="info-box">请先在“楼宇分配”中选择一栋楼宇进入单体执行。</div><button class="btn btn-outline" onclick="Aggregate.switchTab('allocation')">← 返回楼宇分配</button>`;return;}
    el.innerHTML=`
    <div class="page-header"><div><h2>${selected.name} · 单体策略详情</h2><div class="breadcrumb">楼宇协同与策略执行 / 最终任务 ${fmt(selected.final_target,1)} kW</div></div><div style="display:flex;gap:8px"><button class="btn btn-outline btn-sm" onclick="Aggregate.switchTab('allocation')">← 返回楼宇分配</button><button class="btn btn-outline btn-sm" id="scExportBtn" onclick="SingleCtrl.exportRecord()" ${this.execution?.building===selected.name?'':'disabled'}>📥 导出执行记录</button></div></div>

    <div class="info-box">⚙️ <strong>统一任务来源：</strong>这里只执行“楼宇协同策略”已生成的最终任务。冷水机组按15分钟校核，多联机按5分钟校核；混合系统由单体策略分别调用对应设备分支。</div>

    <div class="panel">
      <div class="panel-header"><h3>执行参数</h3></div>
      <div class="panel-body">
        <div class="form-row">
          <input type="hidden" id="scBuilding" value="${selected.id}">
          <div class="form-group" style="min-width:280px"><label>执行楼宇</label><input class="form-input" value="${selected.name}（${selected.acType}）" readonly></div>
          <div class="form-group"><label>协同最终任务 (kW)</label><input class="form-input" type="number" id="scTarget" value="${selected?fmt(selected.final_target,2):''}" readonly></div>
          <div class="form-group"><label>室外温度 (℃)</label><input class="form-input" type="number" id="scOutdoor" value="35"></div>
          <div class="form-group"><label>保持时长 (min)</label><input class="form-input" type="number" id="scDuration" value="60" min="10" step="5"></div>
          <div class="form-group"><label>用户激励状态</label><select class="form-select" id="scIncentive"><option ${selected?.incentive==='无激励'?'selected':''}>无激励</option><option ${selected?.incentive!=='无激励'?'selected':''}>有激励</option></select></div>
          <div class="form-group"><label>协同推荐策略</label><input class="form-input" value="${selected?selected.strategyLevel:'--'}" readonly></div>
          <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-primary" onclick="SingleCtrl.execute()">▶ 开始执行模拟</button></div>
        </div>
      </div>
    </div>

    <div id="scResult"></div>`;
  },
  execute(){
    const bid=parseInt(document.getElementById('scBuilding').value);
    if(!bid){showToast('请先选择楼宇');return;}
    const assignment=this.assignments().find(x=>x.id===bid);
    if(!assignment){showToast('该楼宇不在当前协同分配结果中');return;}
    const target=assignment.final_target;
    const outdoor=parseFloat(document.getElementById('scOutdoor').value)||35;
    const duration=Math.max(10,parseFloat(document.getElementById('scDuration').value)||60);
    const inc=document.getElementById('scIncentive').value;
    const b=assignment;

    this.execution=SingleExecution.execute(b,target,outdoor,inc,duration);
    const e=this.execution;
    Aggregate.executionResults[bid]={actualReduction:e.actualReduction||0,gap:Math.max(0,target-(e.actualReduction||0)),achievementRate:e.achievementRate||0,strategyCode:e.strategyCode||'',success:e.success};
    document.getElementById('scExportBtn').disabled=false;
    const loads=e.timeline?.map(p=>p.load)||[b.baseLoad];
    const minLoad=Math.min(...loads),maxLoad=Math.max(...loads);
    const span=Math.max(1,maxLoad-minLoad);
    const chartPoints=(e.timeline||[]).map((p,i)=>`${30+i*(640/Math.max(1,e.timeline.length-1))},${170-(p.load-minLoad)/span*130}`).join(' ');

    const resultDiv=document.getElementById('scResult');
