/* ============================================================
   第四层：单体调控执行闭环模拟器
   触发→检查→能力判断→策略匹配→执行→校核→升级/降级→恢复
============================================================ */
const SingleExecution={
  buildTimeline(baseline,actualReduction,checkInterval,duration,isVRF){
    const holdMinutes=Math.max(checkInterval*2,Number(duration)||60);
    const batches=isVRF?3:2;
    const reboundRate=isVRF?0.06:0.10;
    const points=[
      {minute:-15,stage:'基准观察',load:baseline,reduction:0},
      {minute:0,stage:'指令下发',load:baseline,reduction:0},
      {minute:checkInterval,stage:'响应爬坡',load:baseline-actualReduction*0.65,reduction:actualReduction*0.65},
      {minute:checkInterval*2,stage:'效果校核',load:baseline-actualReduction,reduction:actualReduction},
      {minute:holdMinutes,stage:'稳定保持',load:baseline-actualReduction,reduction:actualReduction}
    ];
    for(let i=1;i<=batches;i++){
      const reduction=actualReduction*(1-i/batches);
      points.push({minute:holdMinutes+i*checkInterval,stage:`恢复第${i}批`,load:baseline-reduction,reduction});
    }
    const recoveryEnd=holdMinutes+batches*checkInterval;
    const rebound=actualReduction*reboundRate;
    points.push({minute:recoveryEnd+checkInterval,stage:'反弹校核',load:baseline+rebound,reduction:-rebound});
    points.push({minute:recoveryEnd+checkInterval*2,stage:'恢复稳定',load:baseline,reduction:0});
    return points.map(p=>({...p,load:Math.round(p.load*100)/100,reduction:Math.round(p.reduction*100)/100}));
  },
  /**
   * 执行单体调控闭环模拟
   * @param {Object} building - 楼宇对象
   * @param {number} targetReduction - 目标削减量
   * @param {number} outdoorTemp - 室外温度
   * @param {string} incentive - 激励政策
   * @returns {Object} 执行过程记录
   */
  execute(building,targetReduction,outdoorTemp,incentive,duration=60){
    const setTemp=building.setTemp??26;
    const match=StrategyLibrary.match(building,targetReduction,outdoorTemp,incentive);
    const isMixed=building.acType.includes('多联机')&&building.acType.includes('冷水机组');
    const isVRF=building.acType.includes('多联机')&&!building.acType.includes('冷水机组');
    const checkInterval=isVRF?5:15; // 混合系统按较慢的水冷响应周期统一校核
    duration=Math.max(checkInterval*2,Number(duration)||60);
    const executedAt=new Date().toLocaleString('zh-CN',{hour12:false});
    const phases=[];

    // 阶段1：任务触发
    phases.push({phase:'任务触发',status:'done',time:'0min',
      desc:`接收调控任务，目标削减 ${targetReduction}kW，记录基准负荷 ${building.baseLoad}kW`});

    // 阶段2：状态检查
    const checkOK=building.available!==false;
    phases.push({phase:'状态检查',status:checkOK?'done':'blocked',time:`${checkInterval}min`,
      desc:checkOK?'设备、通信、计量正常，存在可调区域，通过检查':'设备异常或无可调区域，阻断执行'});

    if(!checkOK){
      return{building:building.name,success:false,phases:phases,match:match,
        target:targetReduction,actualReduction:0,achievementRate:0,reason:'状态检查未通过，不具备调控条件',exitReason:'设备或通信状态异常'};
    }

    // 阶段3：能力判断
    const capacity=PotentialEngine.calc(building,outdoorTemp,setTemp,incentive,match.tempOffset);
    phases.push({phase:'能力判断',status:'done',time:`${checkInterval*2}min`,
      desc:`当前可调潜力 ${capacity.potential}kW（${capacity.potentialPct}%），安全上限 ${capacity.maxPotential}kW`});

    // 阶段4：策略匹配
    phases.push({phase:'策略匹配',status:'done',time:`${checkInterval*2}min`,
      desc:`匹配到 ${match.matchedLevel===1?'Ⅰ级':match.matchedLevel===2?'Ⅱ级':'Ⅲ级'}策略 ${match.matchedLevelName}，编码 ${match.strategyCode}${isMixed?'；分别调用多联机末端与水冷末端/冷源分支':''}`});

    // 阶段5：指令执行
    phases.push({phase:'指令执行',status:'active',time:`${checkInterval*3}min`,
      desc:`下发指令：末端温度上调 ${match.tempOffset}℃，参与区域 ${Math.round(match.zoneFraction*100)}%，互动目标 ${match.interactiveTarget}%`});

    // 阶段6：效果校核（统一确定性口径）
    let currentLevel=match.matchedLevel;
    const responseRate=PotentialEngine.getHistoryRate(building);
    const actualReduction=PotentialEngine.actualReduction(building,targetReduction,match.actualAdjustable);
    const remainingGap=Math.max(0,targetReduction-actualReduction);
    phases.push({phase:'效果校核',status:remainingGap<=targetReduction*0.05?'done':'warning',time:`${checkInterval*4}min`,
      desc:`可提供量 ${Math.round(match.actualAdjustable)}kW × 历史响应率 ${Math.round(responseRate*100)}%，实际削减 ${Math.round(actualReduction)}kW${remainingGap>0?`，剩余缺口 ${Math.round(remainingGap)}kW`:'，达到目标'}`});

    phases.push({phase:'稳定保持',status:'done',time:`至${duration}min`,
      desc:`按当前策略保持 ${duration}min，期间每 ${checkInterval}min 复核一次负荷与设备状态`});

    // 阶段7：恢复
    phases.push({phase:'分批恢复',status:'done',time:`${duration}min后`,
      desc:`重点区域优先恢复，末端先行冷源后调，每批观察 ${checkInterval}min，分 ${isVRF?3:isMixed?3:2} 批恢复`});

    const finalReduction=actualReduction;
    const timeline=this.buildTimeline(building.baseLoad,finalReduction,checkInterval,duration,isVRF);
    const reboundPeak=Math.max(...timeline.map(p=>p.load))-building.baseLoad;
    const achievementRate=targetReduction>0?Math.round(finalReduction/targetReduction*1000)/10:0;
    const exitReason=achievementRate>=95?'目标完成，按计划退出':match.restricted?'受安全边界限制，返回剩余缺口':'可用潜力或历史响应率不足';
    return{
      building:building.name,
      type:building.type,
      acType:building.acType,
      success:true,
      target:targetReduction,
      actualReduction:Math.round(finalReduction),
      achievementRate,
      finalLevel:currentLevel,
      strategyCode:match.strategyCode,
      checkInterval:checkInterval,
      phases:phases,
      timeline,
      duration:Number(duration)||60,
      executedAt,
      reboundPeak:Math.round(reboundPeak*100)/100,
      exitReason,
      comfortLoss:Math.round(match.tempOffset*10)/10,
      restricted:match.restricted
    };
  }
};

