        <div class="data-table-wrapper" style="margin-top:12px"><table class="data-table"><thead><tr><th>相对时间</th><th>阶段</th><th>负荷(kW)</th><th>削减量(kW)</th></tr></thead><tbody>
          ${(e.timeline||[]).map(p=>`<tr><td>${p.minute} min</td><td>${p.stage}</td><td>${fmt(p.load,2)}</td><td>${fmt(p.reduction,2)}</td></tr>`).join('')}
        </tbody></table></div>
      </div>
    </div>`:`
    <div class="info-box warning"><strong>执行未开始：</strong>${e.reason}</div>`}
    `;
    showToast(e.success?'单体执行记录已生成':'执行被阻断');
  },
  exportRecord(){
