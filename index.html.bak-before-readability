    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon ${e.success?'green':'red'}">${e.success?'✅':'❌'}</div><div class="stat-value" style="font-size:20px">${e.success?'仿真完成':'仿真阻断'}</div><div class="stat-label">仿真状态</div></div>
