    const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='调控执行记录_'+new Date().toISOString().slice(0,10)+'.csv';a.click();showToast('执行记录已导出');
  }
};

