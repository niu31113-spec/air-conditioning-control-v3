  compute() {
    const P = {};
    Object.keys(this.params).forEach(k => { P[k] = parseFloat(this.params[k].value) || 0; });
    const totalTarget = P['全域削峰总目标'] || 256.4;
    const safety = P['单区县安全余量系数'] || 0.2;
    const w1 = P['潜力权重ω₁'] || 0.6, w2 = P['历史响应率权重ω₂'] || 0.25, w3 = P['区域等级系数权重ω₃'] || 0.15;
    const lambda = P['邻接互济分配系数λ'] || 0.8;
    const source = typeof CITY_DISTRICTS!=='undefined' ? CITY_DISTRICTS.map(c=>{
      const old=this.DEFAULT_DISTRICTS.find(d=>d.name===c.district)||{};
      return{name:c.district,tier:c.tier,potential:c.neutral/1000,history_rate:old.history_rate||0.75,region_coeff:old.region_coeff||0.5};
    }) : this.DEFAULT_DISTRICTS;
    const maxPot = Math.max(...source.map(d => d.potential));
    this.districts = source.map((d, i) => {
      const normPot = d.potential / maxPot;
      const A_i = w1 * normPot + w2 * d.history_rate + w3 * d.region_coeff;
      return { seq: i+1, name: d.name, tier: d.tier, group: this.GROUPS[d.name] || '未知',
        potential: d.potential, history_rate: d.history_rate, region_coeff: d.region_coeff,
        norm_potential: normPot, A_i, max_adjustable: d.potential * safety };
    });
    const totalA = this.districts.reduce((s,d) => s + d.A_i, 0);
    this.districts.forEach(d => {
      d.capacity_ratio = d.A_i / totalA;
      d.initial_target = d.capacity_ratio * totalTarget;
      d.first_dispatch = Math.min(d.initial_target, d.max_adjustable);
      d.first_unmet = Math.max(0, d.initial_target - d.max_adjustable);
      d.remaining_space = Math.max(0, d.max_adjustable - d.initial_target);
      d.deviation = d.initial_target - d.max_adjustable;
      d.status = d.deviation > 0.5 ? '缺口' : (d.deviation < -0.5 ? '富余' : '平衡');
      d.intra_group_aid = 0; d.cross_group_aid = 0; d.mutual_aid = 0;
    });
    // 方案A：全域二次下发，只看全市剩余空间。
    const totalFirstUnmet = this.districts.reduce((s, d) => s + d.first_unmet, 0);
    const totalRemainingSpace = this.districts.reduce((s, d) => s + d.remaining_space, 0);
    const secondDispatchTotal = Math.min(totalFirstUnmet, totalRemainingSpace);
    this.districts.forEach(d => {
      d.second_dispatch = totalRemainingSpace > 0 ? Math.min(d.remaining_space, secondDispatchTotal * d.remaining_space / totalRemainingSpace) : 0;
      d.after_second_dispatch = d.first_dispatch + d.second_dispatch;
      d.second_final = d.after_second_dispatch;
      d.second_status = d.second_dispatch > 0.005 ? '接收二次下发' : (d.first_unmet > 0.005 ? '无可调空间' : '无需二次下发');
    });
    // 方案B：先在同片区承接缺口，再跨片区承接；总承接量受互济系数限制。
    this.districts.forEach(d=>{d.mutual_final=d.first_dispatch;d.mutual_capacity=d.remaining_space*lambda;});
    const distribute=(amount,candidates,field)=>{
      const capacity=candidates.reduce((s,d)=>s+Math.max(0,d.mutual_capacity-(d.intra_group_aid+d.cross_group_aid)),0);
      const moved=Math.min(amount,capacity);
      candidates.forEach(d=>{const left=Math.max(0,d.mutual_capacity-(d.intra_group_aid+d.cross_group_aid));const add=capacity>0?moved*left/capacity:0;d[field]+=add;d.mutual_final+=add;});
      return amount-moved;
    };
    const groups={};this.districts.forEach(d=>(groups[d.group]=groups[d.group]||[]).push(d));
    let crossNeed=0;
    Object.values(groups).forEach(gs=>{const need=gs.reduce((s,d)=>s+d.first_unmet,0);crossNeed+=distribute(need,gs.filter(d=>d.remaining_space>0), 'intra_group_aid');});
    distribute(crossNeed,this.districts.filter(d=>d.remaining_space>0),'cross_group_aid');
    this.districts.forEach(d => {
      d.mutual_aid = d.intra_group_aid + d.cross_group_aid;
      d.mutual_adjustment=d.mutual_final-d.initial_target;
      d.final_target=this.selectedScheme==='second'?d.second_final:d.mutual_final;
      d.final_adjustment=d.final_target-d.initial_target;
      d.load_utilization = d.max_adjustable > 0 ? d.final_target / d.max_adjustable : 0;
      d.compliance = d.load_utilization <= 1.05 ? '合规' : '超限';
    });
    const days = 7;
    this.districts.forEach(d => {
      const lr = d.load_utilization;
      let rotDays;
      if (lr >= 0.95) rotDays = Math.ceil(days * 0.85);
      else if (lr >= 0.8) rotDays = Math.ceil(days * 0.7);
      else if (lr >= 0.5) rotDays = Math.ceil(days * 0.57);
      else rotDays = Math.ceil(days * 0.43);
      d.rotDays = Math.max(3, Math.min(rotDays, days - 1));
      d.schedule = [];
      for (let i = 0; i < days; i++) d.schedule.push('');
    });
    const groupNames = ['主城都市区','渝东北三峡库区','渝东南武陵山区'];
    groupNames.forEach((gName, gi) => {
      const gDists = this.districts.filter(d => d.group === gName).sort((a,b) => b.final_target - a.final_target);
      gDists.forEach((d, di) => {
        const restOffsets = [];
        for (let r = 0; r < days - d.rotDays; r++) restOffsets.push((gi + di + r * 3) % days);
        for (let day = 0; day < days; day++) d.schedule[day] = restOffsets.indexOf(day) >= 0 ? '休' : '●';
      });
    });
  },
