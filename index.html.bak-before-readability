<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>重庆空调调控管理系统 V3.0 · 计算引擎驱动版</title>
<style>
:root{
  --bg-deep:#0a0e17;--bg-panel:#111827;--bg-card:#1a2235;--bg-hover:#1e2a40;
  --border:#1e3050;--border-accent:#2a4a7f;--text-primary:#e8edf5;--text-secondary:#8899b4;
  --text-muted:#5a6d85;--accent:#3b82f6;--accent-glow:rgba(59,130,246,.3);--accent-cyan:#06b6d4;
  --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;--orange:#f97316;
  --gradient-1:linear-gradient(135deg,#3b82f6,#06b6d4);--font:'Microsoft YaHei','Noto Sans SC',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--font);background:var(--bg-deep);color:var(--text-primary);min-height:100vh;overflow-x:hidden}
.bg-grid{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(59,130,246,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.03) 1px,transparent 1px);background-size:60px 60px}
.bg-glow{position:fixed;pointer-events:none;z-index:0;width:600px;height:600px;background:radial-gradient(circle,rgba(59,130,246,.06) 0%,transparent 70%);top:-200px;right:-100px}
.app{position:relative;z-index:1;display:flex;min-height:100vh}
.sidebar{width:240px;min-width:240px;background:var(--bg-panel);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:20px 0;position:sticky;top:0;height:100vh;z-index:10}
.sidebar-logo{padding:0 20px 24px;border-bottom:1px solid var(--border);margin-bottom:16px}
.sidebar-logo .logo-icon{width:40px;height:40px;background:var(--gradient-1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;margin-bottom:10px}
.sidebar-logo h1{font-size:15px;font-weight:700;line-height:1.4}
.sidebar-logo span{font-size:11px;color:var(--text-muted)}
.sidebar-nav{flex:1;padding:0 12px;overflow-y:auto}
.nav-section{margin-bottom:8px}
.nav-section-title{font-size:10px;text-transform:uppercase;color:var(--text-muted);letter-spacing:.15em;padding:12px 8px 6px;font-weight:500}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;transition:all .2s;font-size:13px;color:var(--text-secondary);margin-bottom:2px;position:relative}
.nav-item:hover{background:var(--bg-hover);color:var(--text-primary)}
.nav-item.active{background:rgba(59,130,246,.12);color:var(--accent)}
.nav-item.active::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:3px;background:var(--accent);border-radius:0 3px 3px 0}
.nav-item .nav-icon{font-size:18px;width:22px;text-align:center}
.sidebar-footer{padding:16px 20px;border-top:1px solid var(--border);font-size:11px;color:var(--text-muted)}
.status-dot{display:inline-block;width:7px;height:7px;background:var(--success);border-radius:50%;margin-right:6px;box-shadow:0 0 6px var(--success)}
.main{flex:1;padding:0;overflow-y:auto;height:100vh}
.page{display:none;padding:28px 32px}
.page.active{display:block}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.page-header h2{font-size:22px;font-weight:700}
.page-header .breadcrumb{font-size:12px;color:var(--text-muted)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:20px;position:relative;overflow:hidden;transition:all .3s}
.stat-card:hover{border-color:var(--border-accent);box-shadow:0 4px 20px rgba(59,130,246,.08)}
.stat-card .stat-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:12px}
.stat-card .stat-value{font-size:26px;font-weight:700;line-height:1;margin-bottom:4px}
.stat-card .stat-label{font-size:12px;color:var(--text-muted)}
.stat-card .stat-change{font-size:11px;margin-top:8px}
.stat-change.up{color:var(--success)}.stat-change.down{color:var(--danger)}
.stat-icon.blue{background:rgba(59,130,246,.15);color:var(--accent)}
.stat-icon.cyan{background:rgba(6,182,212,.15);color:var(--accent-cyan)}
.stat-icon.purple{background:rgba(139,92,246,.15);color:var(--purple)}
.stat-icon.orange{background:rgba(249,115,22,.15);color:var(--orange)}
.stat-icon.green{background:rgba(16,185,129,.15);color:var(--success)}
.stat-icon.red{background:rgba(239,68,68,.15);color:var(--danger)}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px}
.panel{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;margin-bottom:16px;overflow:hidden}
.panel-header{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border)}
.panel-header h3{font-size:15px;font-weight:600}
.panel-body{padding:20px}
.btn{padding:8px 16px;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;transition:all .2s;font-family:var(--font)}
.btn:hover{opacity:.9;transform:translateY(-1px)}
.btn-primary{background:var(--accent);color:#fff}
.btn-success{background:var(--success);color:#fff}
.btn-warning{background:var(--warning);color:#111}
.btn-danger{background:var(--danger);color:#fff}
.btn-outline{background:transparent;border:1px solid var(--border-accent);color:var(--accent)}
.btn-sm{padding:5px 12px;font-size:12px;border-radius:6px}
.btn-cyan{background:var(--accent-cyan);color:#fff}
.btn-purple{background:var(--purple);color:#fff}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.form-group{margin-bottom:14px}
.form-group label{display:block;font-size:12px;color:var(--text-secondary);margin-bottom:6px}
.form-input,.form-select{width:100%;background:var(--bg-deep);border:1px solid var(--border);color:var(--text-primary);padding:8px 12px;border-radius:8px;font-size:13px;font-family:var(--font)}
.form-input:focus,.form-select:focus{outline:none;border-color:var(--accent)}
.form-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.form-row-sm{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
table.data-table{width:100%;border-collapse:collapse;font-size:12px}
.data-table th{background:var(--bg-panel);color:var(--accent);padding:8px 6px;text-align:center;border:1px solid var(--border);white-space:nowrap;font-weight:600}
.data-table td{background:var(--bg-deep);padding:6px;text-align:center;border:1px solid var(--border);color:var(--text-secondary)}
.data-table tr:hover td{background:var(--bg-hover)}
.data-table .editable input{background:transparent;border:none;color:var(--text-primary);width:100%;text-align:center;font-size:12px;padding:2px}
.data-table .editable input:focus{outline:1px solid var(--accent);background:var(--bg-card)}
.data-table-wrapper{max-height:500px;overflow-y:auto;margin-top:6px;border:1px solid var(--border);border-radius:8px}
.badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600}
.badge-blue{background:rgba(59,130,246,.15);color:var(--accent)}
.badge-cyan{background:rgba(6,182,212,.15);color:var(--accent-cyan)}
.badge-purple{background:rgba(139,92,246,.15);color:var(--purple)}
.badge-green{background:rgba(16,185,129,.15);color:var(--success)}
.badge-red{background:rgba(239,68,68,.15);color:var(--danger)}
.badge-yellow{background:rgba(245,158,11,.15);color:var(--warning)}
.badge-orange{background:rgba(249,115,22,.15);color:var(--orange)}
.chart-bar-container{display:flex;align-items:flex-end;gap:12px;height:200px;padding:10px 0}
.chart-bar-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px}
.chart-bar{width:70%;border-radius:6px 6px 0 0;min-height:4px;transition:height .4s}
.chart-bar-value{font-size:11px;font-weight:700}
.chart-bar-label{font-size:10px;color:var(--text-muted);text-align:center;white-space:nowrap}
.tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px}
.tab-btn{padding:8px 14px;background:var(--bg-panel);border:1px solid var(--border);color:var(--text-secondary);cursor:pointer;font-size:12px;border-radius:8px 8px 0 0;transition:all .2s;font-family:var(--font)}
.tab-btn.active{background:var(--bg-card);color:var(--accent);border-bottom-color:var(--bg-card);font-weight:600}
.tab-content{display:none}
.tab-content.active{display:block}
.info-box{background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:8px;padding:12px 16px;font-size:12px;color:var(--text-secondary);line-height:1.7;margin-bottom:16px}
.info-box strong{color:var(--accent)}
.info-box.green{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.2)}
.info-box.green strong{color:var(--success)}
.info-box.warning{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.2)}
.info-box.warning strong{color:var(--warning)}
.formula-box{margin:8px 0;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.25);border-radius:8px;padding:10px 14px;font-family:ui-monospace,Consolas,monospace;font-size:12.5px;text-align:center;color:var(--accent)}
.mini-tb{width:100%;border-collapse:collapse;margin:8px 0;font-size:12px}
.mini-tb th,.mini-tb td{border:1px solid rgba(255,255,255,.08);padding:5px 8px;text-align:center}
.mini-tb th{background:rgba(255,255,255,.05);color:var(--text-muted);font-weight:600}
details.calc-logic{margin:14px 0;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.07);border-radius:10px;overflow:hidden}
details.calc-logic summary{cursor:pointer;padding:12px 16px;font-size:13px;font-weight:600;color:var(--accent);list-style:none;display:flex;align-items:center;gap:8px}
details.calc-logic summary::-webkit-details-marker{display:none}
.calc-hint{font-size:11px;font-weight:400;color:var(--text-muted)}
.calc-body{padding:4px 18px 18px;color:var(--text-secondary);font-size:12.5px;line-height:1.8}
.calc-body b{color:var(--accent)}
.calc-step{margin:14px 0 6px;font-weight:700;font-size:13px;color:var(--accent-cyan)}
.progress-bar-bg{background:var(--bg-deep);border-radius:6px;height:10px;overflow:hidden}
.progress-bar-fill{height:100%;border-radius:6px;transition:width .4s}
.summary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.summary-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center}
.summary-card .val{font-size:20px;font-weight:700;color:var(--accent-cyan)}
.summary-card .lbl{font-size:10px;color:var(--text-muted);margin-top:4px}
.strategy-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s}
.strategy-card:hover{border-color:var(--border-accent);transform:translateY(-2px)}
.strategy-card.selected{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 6px 20px var(--accent-glow)}
.strategy-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:10px}
.strategy-card h4{font-size:14px;margin-bottom:6px}
.strategy-card p{font-size:11px;color:var(--text-secondary);line-height:1.5;margin-bottom:10px}
.strategy-tags{display:flex;gap:6px;flex-wrap:wrap}
.flow-step{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;margin-bottom:8px}
.flow-step .step-num{width:28px;height:28px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
.flow-step .step-num.done{background:var(--success)}
.flow-step .step-num.active{background:var(--warning);animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.flow-step .step-content{flex:1}
.flow-step .step-title{font-size:13px;font-weight:600}
.flow-step .step-desc{font-size:11px;color:var(--text-muted);margin-top:2px}
.flow-arrow{text-align:center;color:var(--text-muted);font-size:16px;margin:-4px 0}
.compare-table th{background:var(--bg-panel)}
.compare-table td.win{color:var(--success);font-weight:600}
.compare-table td.lose{color:var(--danger)}
.rank-bar{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.rank-bar-name{width:90px;font-size:12px;color:var(--text-secondary);text-align:right;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rank-bar-track{flex:1;height:20px;background:var(--bg-deep);border-radius:4px;overflow:hidden}
.rank-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-cyan));border-radius:4px;transition:width .4s}
.rank-bar-val{width:80px;font-size:12px;font-weight:600;color:var(--accent-cyan);flex-shrink:0}
.flow-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:16px 0}
.flow-grid .flow-step{display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:18px 16px;text-align:center}
.flow-grid .flow-step .num{width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;margin-bottom:10px}
.flow-grid .flow-step h4{font-size:15px;line-height:1.35;margin-bottom:8px;color:var(--text-primary)}
.flow-grid .flow-step p{font-size:12px;color:var(--text-secondary);line-height:1.65}
@media(max-width:1200px){.flow-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){.flow-grid{grid-template-columns:1fr}}
.param-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.param-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:14px}
.param-card h3{font-size:13px;margin-bottom:8px;color:var(--accent-cyan)}
.param-card .value-row{display:flex;align-items:center;gap:8px}
.param-card .value-row input{background:var(--bg-deep);border:1px solid var(--border);color:var(--text-primary);padding:6px 10px;border-radius:6px;font-size:13px;width:100%}
.param-card .unit{font-size:12px;color:var(--text-muted);white-space:nowrap}
.param-card .desc{font-size:10px;color:var(--text-muted);margin-top:6px;line-height:1.4}
.mini-tb{width:100%;border-collapse:collapse;margin:8px 0;font-size:11px}
.mini-tb th,.mini-tb td{border:1px solid var(--border);padding:5px 8px;text-align:center}
.mini-tb th{background:var(--bg-panel);color:var(--accent-cyan)}
.calc-step{font-size:13px;font-weight:600;color:var(--accent);margin:14px 0 6px;padding-left:8px;border-left:3px solid var(--accent)}
@media(max-width:1100px){
  .sidebar{width:64px;min-width:64px}
  .sidebar-logo h1,.sidebar-logo span,.nav-item span:not(.nav-icon),.nav-section-title,.sidebar-footer{display:none}
  .grid-2,.grid-3{grid-template-columns:1fr}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>
<div class="bg-grid"></div>
<div class="bg-glow"></div>
<div class="app">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">⚡</div>
      <h1>重庆空调调控管理系统</h1>
      <span>V3.0 · 计算引擎驱动版</span>
    </div>
    <nav class="sidebar-nav" id="sidebarNav"></nav>
    <div class="sidebar-footer"><span class="status-dot"></span> 计算引擎运行中 · v3.0</div>
  </aside>
  <main class="main">
    <div class="page" id="page-ledger"></div>
    <div class="page" id="page-stratlib"></div>
    <div class="page" id="page-aggregate"></div>
    <div class="page" id="page-district"></div>
    <div class="page" id="page-citypotential"></div>
  </main>
</div>
<div class="toast" id="toast"></div>

<script src="jszip.min.js"></script>
<script>
/* ============================================================
   共享工具
============================================================ */
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._timer);t._timer=setTimeout(()=>t.classList.remove('show'),2600)}
function fmt(v,d){d=d??2;const n=parseFloat(v);return isNaN(n)?v:n.toFixed(d)}
function fmtInt(v){return Math.round(v).toLocaleString()}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
const NAV_ITEMS=[
  {section:'基础数据层',items:[{page:'ledger',icon:'🏢',label:'楼宇台账·潜力计算'},{page:'citypotential',icon:'📈',label:'全市可调潜力推算'}]},
  {section:'潜力与分配层',items:[{page:'district',icon:'🗺️',label:'区县可调潜力分配'}]},
  {section:'调控执行层',items:[{page:'aggregate',icon:'🤝',label:'楼宇协同与策略执行'}]}
];
function buildNav(){
  const nav=document.getElementById('sidebarNav');
  nav.innerHTML=NAV_ITEMS.map(s=>`<div class="nav-section"><div class="nav-section-title">${s.section}</div>${s.items.map(i=>`<div class="nav-item" data-page="${i.page}"><span class="nav-icon">${i.icon}</span> <span>${i.label}</span></div>`).join('')}</div>`).join('');
  nav.querySelectorAll('.nav-item').forEach(item=>{item.addEventListener('click',()=>navigateTo(item.dataset.page))});
}
let currentPage='citypotential';
function navigateTo(page){
  currentPage=page;
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.querySelector(`.nav-item[data-page="${page}"]`).classList.add('active');
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(`page-${page}`).classList.add('active');
  if(page==='ledger')Ledger.render();
  if(page==='citypotential')CityPotential.render();
  if(page==='stratlib')StrategyLib.render();
  if(page==='district')DistrictAlloc.init();
  if(page==='aggregate')Aggregate.render();
  window.scrollTo(0,0);
}

/* ============================================================
   第一层：可调潜力计算引擎（核心地基）
   基于计算说明书：ΔP = P·α·K·ΔT
   多联机：高响应K取大；冷水机组：K取小且随温度动态修正
============================================================ */
const PotentialEngine={
  // K系数表：不同建筑类型 × 使用年限（单位 1/℃），来自计算说明书表3
  K_TABLE:{
    '党政机关':{'5年内':0.45,'5-10年':0.45,'10-15年':0.40},
    '企事业单位':{'5年内':0.40,'5-10年':0.40,'10-15年':0.38},
    '办公写字楼':{'5年内':0.45,'5-10年':0.45,'10-15年':0.40},
    '商业综合体':{'5年内':0.40,'5-10年':0.40,'10-15年':0.38},
    '商超':{'5年内':0.38,'5-10年':0.38,'10-15年':0.36},
    '酒店':{'5年内':0.38,'5-10年':0.38,'10-15年':0.35}
  },
  // 用户响应系数α：无激励 / 有激励，来自计算说明书表3（26℃基准）
  ALPHA_TABLE:{
    '党政机关':{'无激励':0.075,'有激励':0.10},
    '企事业单位':{'无激励':0.005,'有激励':0.075},
    '办公写字楼':{'无激励':0.05,'有激励':0.075},
    '商业综合体':{'无激励':0.05,'有激励':0.075},
    '商超':{'无激励':0.005,'有激励':0.05},
    '酒店':{'无激励':0.0,'有激励':0.025}
  },
  HISTORY_RATE:{'党政机关':0.95,'企事业单位':0.85,'办公写字楼':0.92,'商业综合体':0.88,'商超':0.80,'酒店':0.75},
  // 冷水机组冷冻水温提升效率系数：每提升1℃，压缩机功耗下降约3%（ASHRAE标准）
  CHW_EFFICIENCY_PER_C:0.03,
  // 室外温度分段削减率（来自计算说明书）
  TEMP_SEGMENTS:{
    '30-34℃':{reductionRate:0.062,label:'30-34℃'},
    '35-39℃':{reductionRate:0.072,label:'35-39℃'},
    '40+℃':{reductionRate:0.082,label:'40℃以上'}
  },

  // 获取K系数
  getK(buildingType,age){
    const tier=this.K_TABLE[buildingType]||this.K_TABLE['办公写字楼'];
    return tier[age]||0.40;
  },
  // 获取响应系数α
  getAlpha(buildingType,incentive){
    const tier=this.ALPHA_TABLE[buildingType]||this.ALPHA_TABLE['办公写字楼'];
    return tier[incentive]??0.05;
  },
  getHistoryRate(building){return Number.isFinite(building.historyRate)?building.historyRate:(this.HISTORY_RATE[building.type]??0.85);},
  actualReduction(building,target,available){
    const requested=Math.max(0,Number(target)||0);
    const capacity=Math.max(0,Number(available)||0);
    return Math.min(requested,capacity*this.getHistoryRate(building));
  },
  // 获取温度分段
  getTempSegment(outdoorTemp){
    if(outdoorTemp>=40)return this.TEMP_SEGMENTS['40+℃'];
    if(outdoorTemp>=35)return this.TEMP_SEGMENTS['35-39℃'];
    return this.TEMP_SEGMENTS['30-34℃'];
  },

  /**
   * 计算单栋楼宇可调潜力（核心公式）
   * @param {Object} building - 楼宇对象
   * @param {number} outdoorTemp - 室外温度℃
   * @param {number} setTemp - 室内设定温度℃
   * @param {string} incentive - '无激励' / '有激励'
   * @param {number} tempOffset - 温度上调幅度℃（默认1）
   * @returns {Object} 潜力计算结果
   */
  calc(building,outdoorTemp,setTemp,incentive,tempOffset){
    incentive=incentive==='按楼宇配置'?(building.incentive||'有激励'):incentive;
    const requestedOffset=tempOffset==='按楼宇配置'?(building.tempOffset??1):(tempOffset??1);
    tempOffset=Math.min(Math.max(0,requestedOffset),building.maxTempOffset??requestedOffset);
    const P=building.baseLoad; // 基准负荷 kW
    setTemp=building.setTemp??setTemp??26;
    const K=this.getK(building.type,building.age); // 空调本体可调潜力系数
    const alpha=this.getAlpha(building.type,incentive); // 用户响应系数
    const deltaT=Math.max(0,outdoorTemp-setTemp); // 室内外温差
    const seg=this.getTempSegment(outdoorTemp);

    // 多联机模型：ΔP = P·α·K·ΔT·温度上调幅度
    // 冷水机组模型：末端负荷削减 + 冷冻水温效率提升
    let potential=0;
    let detail={};

    if(Number.isFinite(building.sourcePotential)){
      const anchorAlpha=this.getAlpha(building.type,'有激励');
      const tempFactor=seg.reductionRate/this.TEMP_SEGMENTS['35-39℃'].reductionRate;
      const incentiveFactor=anchorAlpha===0?1:alpha/anchorAlpha;
      potential=building.sourcePotential*tempFactor*incentiveFactor*tempOffset;
      detail={model:'实测标杆情景修正',formula:'ΔP = P实测 × f温度 × f响应 × Δt',
        components:{实测标杆:building.sourcePotential,温度修正:tempFactor,响应修正:incentiveFactor,上调幅度:tempOffset}};
    }else if(building.acType==='多联机'){
      // 多联机：高响应特性，K取大，线性关系
      potential=P*alpha*K*deltaT*tempOffset;
      detail={model:'多联机面板控制型',formula:'ΔP = P·α·K·ΔT·Δt',
        components:{基准负荷P:P,响应系数α:alpha,K系数:K,温差ΔT:deltaT,上调幅度:tempOffset}};
    }else{
      // 冷水机组：末端削减（量变）+ 冷冻水温效率提升（质变）
      // 末端负荷削减率 = 削减率/℃ × 上调幅度
      const terminalReduction=P*seg.reductionRate*tempOffset*alpha;
      // 冷冻水温提升效率收益：基准功率 × 3%/℃ × 上调幅度
      const chwEfficiencyGain=P*this.CHW_EFFICIENCY_PER_C*tempOffset*0.5; // 0.5为实际可利用率
      potential=terminalReduction+chwEfficiencyGain;
      detail={model:'冷水机组冷冻水温调节型',formula:'ΔP = P·η(Tout)·Δt·α + P·3%·Δt',
        components:{基准负荷P:P,末端削减率:seg.reductionRate,响应系数α:alpha,
          末端削减量:terminalReduction,冷冻水效率收益:chwEfficiencyGain,温度分段:seg.label}};
    }

    // 安全上限单独用于风险提示；不覆盖经确认的实测潜力口径。
    const maxPotential=Number.isFinite(building.safeLimit)?building.safeLimit:P*0.30;
    const actualPotential=Math.max(0,potential);

    return {
      building:building.name,
      type:building.type,
      acType:building.acType,
      baseLoad:P,
      outdoorTemp:outdoorTemp,
      setTemp:setTemp,
      incentive:incentive,
      potential:Math.round(actualPotential*100)/100,
      potentialPct:Math.round(actualPotential/P*1000)/10,
      maxPotential:Math.round(maxPotential*100)/100,
      capped:potential>maxPotential,
      detail:detail
    };
  },

  // 批量计算所有楼宇潜力
  calcAll(buildings,outdoorTemp,setTemp,incentive,tempOffset){
    return buildings.map(b=>this.calc(b,outdoorTemp,setTemp,incentive,tempOffset));
  },

  // 汇总潜力
  summarize(results){
    const total=results.reduce((s,r)=>s+r.potential,0);
    const byType={};
    const byAC={};
    results.forEach(r=>{
      byType[r.type]=(byType[r.type]||0)+r.potential;
      byAC[r.acType]=(byAC[r.acType]||0)+r.potential;
    });
    return{total,byType,byAC,count:results.length};
  }
};

