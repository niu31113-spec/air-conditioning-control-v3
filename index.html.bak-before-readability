        <div class="formula-box">分业态潜力 ΔPm,c = Pm,c × 楼宇户当量 Nm,c；区县潜力 ΔPm = Σc ΔPm,c</div>
        <div class="formula-box">全市中性潜力 = Σ38区县 ΔPm；保守潜力 = 中性潜力 × 0.66；可下发量 = 中性潜力 × ${Math.round(this.dispatchRatio*100)}%（比例可在上方卡片调整）</div>
        <div class="calc-note green">💡 例：渝北区属于第一梯队，覆盖率 0.68、衰减系数 0.48，商业综合体标杆 1084.3 kW 修正为 353.92 kW/户，再乘以商业综合体户当量 191.4 户，得到约 67.74 MW 分业态潜力。</div>
        <div class="calc-note">📌 数据口径：基于 61 户有效实测样本及 38 个区县分层测算参数，形成全市中性、保守和可下发潜力结果。</div>
      </div>
    </details>
    ${ParameterCatalog.render()}
    ${this.sensitivityView()}
    <div class="flow-grid">
      <div class="flow-step"><div class="num">1</div><h4>样本台账归类</h4><p>把实测用户按党政机关、企事业单位、办公写字楼、商业综合体、酒店、商超六类归并。</p></div>
      <div class="flow-step"><div class="num">2</div><h4>提取单户标杆</h4><p>用同类有效样本的可调潜力均值形成 P̄c，作为全市外推标杆。</p></div>
      <div class="flow-step"><div class="num">3</div><h4>区县分层修正</h4><p>按五个梯队配置覆盖率 Ck 和衰减系数 Dk，体现城区密度、接入条件和响应折减。</p></div>
      <div class="flow-step"><div class="num">4</div><h4>户当量扩容</h4><p>把区县经济量折算成总楼宇户当量，再按梯队业态结构分配到六类建筑。</p></div>
      <div class="flow-step"><div class="num">5</div><h4>全域汇总</h4><p>逐区县、逐业态求和，形成中性、保守和 20% 可下发三种结果。</p></div>
    </div>
    <div class="grid-2">
      <div class="panel"><div class="panel-header"><h3>六类业态单户标杆</h3><span style="font-size:11px;color:var(--text-muted)">实测台账 / 过程表</span></div>
        <div class="panel-body"><table class="data-table"><thead><tr><th>业态</th><th>样本户数</th><th>样本潜力均值(kW)</th><th>测算采用值(kW)</th></tr></thead><tbody>${benchmarkRows}</tbody></table></div></div>
      <div class="panel"><div class="panel-header"><h3>区县中性潜力 TOP10</h3><span style="font-size:11px;color:var(--text-muted)">最高：${topDistrict.district} ${fmt(this.mw(topDistrict.neutral),1)} MW</span></div>
        <div class="panel-body">${topBars}</div></div>
    </div>
    <div class="panel">
      <div class="panel-header"><h3>测算结果与过程追溯</h3>
        <div class="tabs" style="margin:0">
          ${[['districts','区县结果'],['tiers','梯队汇总'],['process','过程明细']].map(([k,l])=>`<button class="tab-btn ${this.tab===k?'active':''}" onclick="CityPotential.switchTab('${k}')">${l}</button>`).join('')}
        </div></div>
      <div class="panel-body">
        <div class="form-row" style="margin-bottom:12px">
          <div class="form-group"><label>梯队筛选</label><select class="form-select" onchange="CityPotential.setTier(this.value)">
            ${['全部','第一梯队','第二梯队','第三梯队','第四梯队','第五梯队'].map(t=>`<option ${this.tier===t?'selected':''}>${t}</option>`).join('')}</select></div>
          <div class="form-group"><label>区县筛选（过程明细）</label><select class="form-select" onchange="CityPotential.setDistrict(this.value)">
            ${['全部',...CITY_DISTRICTS.map(d=>d.district)].map(d=>`<option ${this.district===d?'selected':''}>${d}</option>`).join('')}</select></div>
        </div>
        <div id="cityPotentialTab"></div>
      </div>
    </div>`;
    this.renderTab();
  },
  switchTab(tab){this.tab=tab;this.render();},
  setMode(mode){this.mode=mode;this.dispatchOverride=null;this.render();showToast(mode==='standard'?'已切换至标准口径':'已联动楼宇台账当前情景');},
  setTier(tier){this.tier=tier;this.render();},
  setDistrict(district){this.district=district;this.render();},
  renderTab(){
    const body=document.getElementById('cityPotentialTab');
    if(!body)return;
    if(this.tab==='districts'){
      const rows=this.filteredDistricts().sort((a,b)=>b.neutral-a.neutral);
      const total=this.totals(rows);
      const grand=this.totals();
      body.innerHTML=`<div class="data-table-wrapper"><table class="data-table"><thead><tr>
        <th>#</th><th>区县</th><th>梯队</th><th>经济量当量(亿元)</th><th>楼宇户当量</th><th>中性潜力(MW)</th><th>保守潜力(MW)</th><th>20%下发(MW)</th><th>全市占比</th></tr></thead><tbody>
        ${rows.map((d,i)=>`<tr><td>${i+1}</td><td style="text-align:left"><strong>${d.district}</strong></td><td><span class="badge badge-blue">${d.tier}</span></td>
          <td>${fmt(d.economy,0)}</td><td>${fmt(d.householdEquivalent,1)}</td><td style="color:var(--accent-cyan);font-weight:600">${fmt(this.mw(d.neutral),2)}</td>
          <td>${fmt(this.mw(d.conservative),2)}</td><td>${fmt(this.mw(d.dispatch20),2)}</td><td>${fmt(d.neutral/grand.neutral*100,1)}%</td></tr>`).join('')}
        <tr style="background:var(--bg-panel)"><td colspan="4"><strong>当前筛选合计</strong></td><td>${fmt(total.householdEquivalent,1)}</td><td>${fmt(this.mw(total.neutral),2)}</td><td>${fmt(this.mw(total.conservative),2)}</td><td>${fmt(this.mw(total.dispatch20),2)}</td><td>${fmt(total.neutral/grand.neutral*100,1)}%</td></tr>
      </tbody></table></div>`;
    }else if(this.tab==='tiers'){
      const tiers=['第一梯队','第二梯队','第三梯队','第四梯队','第五梯队'];
      const grand=this.totals();
      body.innerHTML=`<div class="data-table-wrapper"><table class="data-table"><thead><tr>
        <th>梯队</th><th>区县数</th><th>覆盖率Ck</th><th>衰减系数Dk</th><th>户当量</th><th>中性潜力(MW)</th><th>保守潜力(MW)</th><th>20%下发(MW)</th><th>贡献占比</th></tr></thead><tbody>
        ${tiers.map(t=>{const rows=this.districtRows().filter(d=>d.tier===t);const total=this.totals(rows);const f=CITY_TIER_FACTORS[t];return`<tr>
          <td style="text-align:left"><strong>${t}</strong></td><td>${rows.length}</td><td>${fmt(f.coverage,2)}</td><td>${fmt(f.decay,2)}</td>
          <td>${fmt(total.householdEquivalent,1)}</td><td style="color:var(--accent-cyan);font-weight:600">${fmt(this.mw(total.neutral),2)}</td>
          <td>${fmt(this.mw(total.conservative),2)}</td><td>${fmt(this.mw(total.dispatch20),2)}</td><td>${fmt(total.neutral/grand.neutral*100,1)}%</td></tr>`;}).join('')}
        <tr style="background:var(--bg-panel)"><td><strong>全市合计</strong></td><td>38</td><td>-</td><td>-</td><td>${fmt(grand.householdEquivalent,1)}</td><td>${fmt(this.mw(grand.neutral),2)}</td><td>${fmt(this.mw(grand.conservative),2)}</td><td>${fmt(this.mw(grand.dispatch20),2)}</td><td>100%</td></tr>
      </tbody></table></div>`;
    }else{
      const rows=this.filteredProcessRows();
      const sum=rows.reduce((s,r)=>s+r.potential,0);
      body.innerHTML=`<div class="info-box">当前筛选共 ${rows.length} 条过程记录，分业态中性潜力合计 <strong>${fmt(this.mw(sum),2)} MW</strong>。过程表按"测算过程明细"口径生成。</div>
      <div class="data-table-wrapper"><table class="data-table"><thead><tr>
        <th>区县</th><th>梯队</th><th>业态</th><th>单户标杆(kW)</th><th>覆盖率Ck</th><th>衰减Dk</th><th>修正单户(kW/户)</th><th>业态户当量</th><th>分业态潜力(MW)</th></tr></thead><tbody>
        ${rows.map(r=>`<tr><td style="text-align:left"><strong>${r.district}</strong></td><td>${r.tier}</td><td><span class="badge badge-purple">${r.category}</span></td>
          <td>${fmt(r.benchmark,1)}</td><td>${fmt(r.coverage,2)}</td><td>${fmt(r.decay,2)}</td><td>${fmt(r.corrected,2)}</td>
          <td>${fmt(r.equivalent,2)}</td><td style="color:var(--accent-cyan);font-weight:600">${fmt(this.mw(r.potential),3)}</td></tr>`).join('')}
      </tbody></table></div>`;
    }
  },
  setDispatchRatio(ratioStr){
    const ratio=parseFloat(ratioStr)/100;
    if(isNaN(ratio)||ratio<=0||ratio>1){showToast('比例需在1%-100%之间');return;}
    this.dispatchRatio=ratio;
    this.dispatchOverride=null;
    this.render();
    showToast(`可下发比例已设为 ${Math.round(ratio*100)}%`);
  },
  setDispatchValue(valStr){
    const val=parseFloat(valStr);
    if(isNaN(val)||val<=0){showToast('请输入有效数值');return;}
    this.dispatchOverride=val;
    const total=this.totals();
    const neutralMW=this.mw(total.neutral);
    if(neutralMW>0){this.dispatchRatio=val/neutralMW;}
    this.render();
    showToast(`可下发量已设为 ${val} MW`);
  },
  exportCSV(){
    let csv='\ufeff区县,梯队,经济量当量亿元,楼宇户当量,中性潜力MW,保守潜力MW,可下发MW\n';
    this.districtRows().forEach(d=>{csv+=[d.district,d.tier,d.economy,d.householdEquivalent,fmt(this.mw(d.neutral),3),fmt(this.mw(d.conservative),3),fmt(this.mw(d.dispatch20),3)].map(x=>'"'+String(x).replace(/"/g,'""')+'"').join(',')+'\n';});
    csv+=ParameterCatalog.csv();
    const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));
    a.download='全市可调潜力推算_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
    showToast('全市潜力推算结果已导出');
  }
};

/* ============================================================
   初始化
============================================================ */
BuildingConfigStore.load();
buildNav();
navigateTo('citypotential');
</script>
