      <div class="stat-card"><div class="stat-icon cyan">📊</div><div class="stat-value">${e.actualReduction}</div><div class="stat-label">仿真削减量 (kW)</div></div>
      <div class="stat-card"><div class="stat-icon ${e.achievementRate>=90?'green':'orange'}">%</div><div class="stat-value">${e.achievementRate}%</div><div class="stat-label">目标达成率</div></div>
    </div>

    ${e.success?`
    <div class="grid-2">
      <div class="panel">
        <div class="panel-header"><h3>执行信息</h3></div>
        <div class="panel-body">
          <table class="mini-tb">
            <tr><th>项目</th><th>值</th></tr>
            <tr><td>楼宇</td><td>${e.building}</td></tr>
            <tr><td>指令下发时间</td><td>${e.executedAt}</td></tr>
            <tr><td>业态/空调</td><td>${e.type} / ${e.acType}</td></tr>
            <tr><td>最终策略等级</td><td>${e.finalLevel===1?'Ⅰ级':e.finalLevel===2?'Ⅱ级':'Ⅲ级'}</td></tr>
            <tr><td>策略编码</td><td><span class="badge badge-green">${e.strategyCode}</span></td></tr>
            <tr><td>校核周期</td><td>${e.checkInterval} min（${e.acType.includes('冷水机组')&&e.acType.includes('多联机')?'混合系统按较慢周期':e.acType.includes('多联机')?'多联机快速响应':'水冷等待稳定'}）</td></tr>
            <tr><td>保持时长</td><td>${e.duration} min</td></tr>
            <tr><td>恢复反弹峰值</td><td>${fmt(e.reboundPeak,2)} kW</td></tr>
            <tr><td>退出原因</td><td>${e.exitReason}</td></tr>
            <tr><td>舒适度损失</td><td>温度上调 ${e.comfortLoss}℃</td></tr>
            <tr><td>限制区域</td><td style="text-align:left;font-size:11px">${e.restricted}</td></tr>
          </table>
        </div>
      </div>
      <div class="panel">
        <div class="panel-header"><h3>执行闭环流程</h3></div>
        <div class="panel-body">
          ${e.phases.map((p,i)=>`
            <div class="flow-step">
              <div class="step-num ${p.status==='done'?'done':p.status==='active'?'active':''}">${i+1}</div>
              <div class="step-content">
                <div class="step-title">${p.phase} <span style="font-size:10px;color:var(--text-muted);margin-left:8px">${p.time}</span></div>
                <div class="step-desc">${p.desc}</div>
              </div>
              <div>${p.status==='done'?'<span class="badge badge-green">完成</span>':p.status==='active'?'<span class="badge badge-yellow">进行中</span>':p.status==='blocked'?'<span class="badge badge-red">阻断</span>':'<span class="badge badge-blue">待执行</span>'}</div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-header"><h3>负荷调控与恢复曲线</h3><span style="font-size:11px;color:var(--text-muted)">基准 → 下发 → 校核 → 保持 → 分批恢复 → 反弹校核</span></div>
