const ConsistencyCheck={
  results(){
    const sample=DATA_PROFILE.validate();
    const sampleLimits=BUILDINGS.every(b=>b.sourcePotential>=0&&b.sourcePotential<=b.baseLoad+0.01);
    const city=CityPotential.standardCheck();
