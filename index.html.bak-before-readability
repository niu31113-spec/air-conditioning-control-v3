  // 生成策略编码
  genCode(buildingType,acType,mode,level){
    const typeCode=this.TYPE_CODES[buildingType]||'BG';
    const hasVRF=acType.includes('多联机'),hasWC=acType.includes('冷水机组');
    const acCode=hasVRF&&hasWC?'MIX':hasVRF?'VRF':'WC';
    const modeCode=mode==='柔性调节'?'F':'I';
    return `${typeCode}-${acCode}-${modeCode}-${level}`;
  },

  /**
   * 策略匹配算法（来自调控策略说明书4.2节）
   * 原则：优先选择能满足目标的最低等级策略，由Ⅰ级向Ⅱ级、Ⅲ级逐级调用
   * @param {Object} building - 楼宇对象
   * @param {number} targetReduction - 目标削减量 kW
   * @param {number} outdoorTemp - 室外温度
   * @param {string} incentive - 激励政策
   * @returns {Object} 匹配结果
   */
  match(building,targetReduction,outdoorTemp,incentive){
    const strat=this.STRATEGIES[building.type]||this.STRATEGIES['办公写字楼'];
    const setTemp=building.setTemp??26;
    let matchedLevel=0;
    const levelResults=[];

    // 逐级计算每级能提供的削减量
    for(let i=0;i<3;i++){
      const lv=strat.levels[i];
      const pot=PotentialEngine.calc(building,outdoorTemp,setTemp,incentive,lv.tempOffset);
      // 实际可调 = 潜力 × 参与区域比例
      const actualAdjustable=pot.potential*lv.zoneFraction;
      levelResults.push({level:i+1,code:lv.code,name:lv.name,potential:pot.potential,
        zoneFraction:lv.zoneFraction,actualAdjustable:actualAdjustable,
        interactiveTarget:lv.interactiveTarget,tempOffset:lv.tempOffset,
        meetsTarget:actualAdjustable>=targetReduction});
      if(actualAdjustable>=targetReduction&&matchedLevel===0)matchedLevel=i+1;
    }

    // 如果三级都不满足，返回最高级+剩余缺口
    const finalLevel=matchedLevel||3;
    const selected=levelResults[finalLevel-1];
    const remainingGap=Math.max(0,targetReduction-selected.actualAdjustable);

    return{
      building:building.name,
      type:building.type,
      acType:building.acType,
      targetReduction:targetReduction,
      matchedLevel:finalLevel,
      matchedLevelName:selected.name,
      strategyCode:this.genCode(building.type,building.acType,'柔性调节',selected.code),
      actualAdjustable:Math.round(selected.actualAdjustable*100)/100,
      remainingGap:Math.round(remainingGap*100)/100,
      meetsTarget:remainingGap<=0.01,
      tempOffset:selected.tempOffset,
      zoneFraction:selected.zoneFraction,
      interactiveTarget:selected.interactiveTarget,
      restricted:strat.restricted,
      allLevels:levelResults
    };
  }
};

