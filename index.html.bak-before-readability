    const xml=async path=>{const entry=zip.file(path);if(!entry)throw new Error(`Excel缺少文件：${path}`);return new DOMParser().parseFromString(await entry.async('text'),'application/xml')};
    const workbook=await xml('xl/workbook.xml'),rels=await xml('xl/_rels/workbook.xml.rels');
