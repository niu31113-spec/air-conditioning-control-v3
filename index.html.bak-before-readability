  districtTask(){DistrictAlloc.compute();return DistrictAlloc.districts.find(d=>d.name===this.selectedDistrict)?.final_target||0;},
  setDistrict(name){this.selectedDistrict=name;this.executionResults={};this.selectedBuildingId=null;this.computeSynergy();this.render();},
  computeSynergy(){
    const P={};
    Object.keys(this.synergyParams).forEach(k=>{P[k]=parseFloat(this.synergyParams[k].value)||0;});
    const totalTargetKW=this.districtTask()*1000;
    const maxRatio=P['单楼宇安全利用比例'];
    const mutualSafety=P['协同承接安全系数'];

    this.synergyBuildings=this.sourceBuildings().filter(b=>b.available!==false&&b.district===this.selectedDistrict).map((b,index)=>{
      const weight=this.getPriorityWeight(b.priority);
      const calibratedPotential=b.potential;
      const weightedPot=calibratedPotential*weight;
      const benchmark=(b.benchmarkId&&BUILDINGS.find(x=>x.id===b.benchmarkId))||BUILDINGS.find(x=>x.type===b.category&&(x.acType===b.acType||x.acType.includes(b.acType)||b.acType.includes(x.acType)))||BUILDINGS.find(x=>x.type===b.category);
      const scale=benchmark?.sourcePotential?calibratedPotential/benchmark.sourcePotential:1;
      const responseMin=b.acType.includes('多联机')&&!b.acType.includes('冷水机组')?5:15;
      const constraint=b.category==='商业综合体'?'避让餐饮、影院、儿童区和大型活动':b.category==='商超'?'避让冷链、生鲜及熟食区域':b.category==='酒店'?'避让在用客房、会议宴会和重要接待':b.category==='党政机关'?'避让机房、会议和政务窗口':b.category==='企事业单位'?'避让工艺、实验及连续保障区域':'避让敏感租户和重点区域';
      return{...b,seq:index+1,type:b.category,potential:calibratedPotential,sourcePotential:calibratedPotential,baseLoad:b.baseLoad||(benchmark?.baseLoad||calibratedPotential*5)*scale,capacity:b.capacity||(benchmark?.capacity||calibratedPotential*7)*scale,safeLimit:calibratedPotential,setTemp:b.setTemp??benchmark?.setTemp??26,incentive:b.incentive||benchmark?.incentive||'有激励',tempOffset:b.tempOffset??b.maxTempOffset??benchmark?.tempOffset??1,maxTempOffset:b.maxTempOffset??benchmark?.maxTempOffset??1,available:b.available!==false,weight,weightedPot,responseMin,constraint,eligible:b.available!==false,checkStatus:b.available===false?'当前不可用':'具备调控条件',dataSource:b.custom?'用户录入/Excel导入':b.benchmarkId?'61户实测对象校准':'61户同类样本标杆估算',calibrationName:benchmark?.name||'同类样本'};
    });
    const totalWeighted=this.synergyBuildings.reduce((s,b)=>s+b.weightedPot,0);
    this.synergyBuildings.forEach(b=>{
      b.initial_target=totalWeighted>0?(b.weightedPot/totalWeighted)*totalTargetKW:0;
      b.safety_limit=b.potential*maxRatio;
      b.initial_executable=Math.min(b.initial_target,b.safety_limit);
      b.transfer_out=Math.max(0,b.initial_target-b.initial_executable);
      b.remaining_space=Math.max(0,b.safety_limit-b.initial_executable);
      b.accepted=0;
    });
    const totalDeficit=this.synergyBuildings.reduce((s,b)=>s+b.transfer_out,0);
    const donors=this.synergyBuildings.filter(b=>b.remaining_space>0.005);
    const totalSafeSpace=donors.reduce((s,b)=>s+b.remaining_space*mutualSafety,0);
    const availableAid=Math.min(totalDeficit,totalSafeSpace);
    donors.forEach(b=>{b.accepted=totalSafeSpace>0?availableAid*(b.remaining_space*mutualSafety/totalSafeSpace):0;});
    this.synergyBuildings.forEach(b=>{
      b.final_target=b.initial_executable+b.accepted;
      b.adjustment=b.final_target-b.initial_target;
      b.final_util=b.safety_limit>0?b.final_target/b.safety_limit:0;
      b.final_compliance=b.final_util<=1.0?'合规':'超限';
      b.strategyLevel='Ⅰ级';
